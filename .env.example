# ==========================================================================
#  MEDISTORE MS — environment reference
# ==========================================================================
#  ⚠️ This file is DOCUMENTATION ONLY.
#
#  It is NOT read at runtime. The app is a static multi-page site whose
#  `pages/*.html` load JavaScript as CLASSIC scripts, where `import.meta.env`
#  is a syntax error. Runtime configuration therefore lives in
#  `js/supabase-config.js` (a plain `window` global), and the real values are
#  duplicated below purely so a human can find them in one place.
#
#  To change values at deploy time, add BEFORE the other scripts:
#     <script>window.__MSMS_ENV__ = { url: "...", publishableKey: "..." };</script>
# ==========================================================================

# --- Supabase project -----------------------------------------------------
VITE_SUPABASE_URL=https://rzuihpcvelaxxbschzkb.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Z-LgIoXgXNCIP-I6rwxrnQ_kwj0u1L1

# --- Object storage -------------------------------------------------------
VITE_SUPABASE_BUCKET=prescriptions

# --- Application ----------------------------------------------------------
VITE_APP_CURRENCY=INR
VITE_APP_CURRENCY_SYMBOL=₹
VITE_APP_TIMEZONE=Asia/Kolkata

# ==========================================================================
#  NEVER put a `service_role` key in this file or anywhere in the frontend.
#  A service_role key bypasses Row Level Security completely.
# ==========================================================================
